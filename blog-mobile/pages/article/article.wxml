<view class="article-detail" wx:if="{{!loading && article}}">
  <!-- 封面图 -->
  <image wx:if="{{article.coverImage}}" src="{{article.coverImage}}" mode="widthFix" class="cover-image"></image>

  <!-- 文章信息 -->
  <view class="article-header">
    <view class="title">{{article.title}}</view>
    <view class="author-info flex-center">
      <image wx:if="{{article.author.avatar}}" src="{{article.author.avatar}}" class="avatar"></image>
      <view class="author-text">
        <text class="author-name">{{article.author.nickname}}</text>
        <text class="publish-date">{{article.publishedAt}}</text>
      </view>
    </view>
    <view class="article-tags">
      <text class="category-tag">{{article.category.name}}</text>
      <text wx:for="{{article.tags}}" wx:key="id" class="tag">{{item.name}}</text>
    </view>
  </view>

  <!-- 文章正文 -->
  <view class="article-content card">
    <!-- TODO: 使用 rich-text 组件渲染 HTML 内容 -->
    <rich-text nodes="{{article.content}}"></rich-text>
  </view>

  <!-- 上下篇导航 -->
  <view class="prev-next-nav card" wx:if="{{prevNext.previous || prevNext.next}}">
    <view
      wx:if="{{prevNext.previous}}"
      class="nav-item prev"
      bindtap="goToArticle"
      data-id="{{prevNext.previous.id}}"
    >
      <text class="nav-label">上一篇</text>
      <text class="nav-title text-ellipsis">{{prevNext.previous.title}}</text>
    </view>
    <view wx:else class="nav-item"></view>
    <view
      wx:if="{{prevNext.next}}"
      class="nav-item next"
      bindtap="goToArticle"
      data-id="{{prevNext.next.id}}"
    >
      <text class="nav-label">下一篇</text>
      <text class="nav-title text-ellipsis">{{prevNext.next.title}}</text>
    </view>
    <view wx:else class="nav-item"></view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section card">
    <view class="section-title">评论 ({{comments.length}})</view>

    <!-- 评论输入框 -->
    <view class="comment-input-wrap">
      <input
        class="comment-input"
        placeholder="{{isLoggedIn ? '写下你的评论...' : '登录后即可发表评论'}}"
        value="{{commentText}}"
        bindinput="onCommentInput"
        disabled="{{!isLoggedIn}}"
        bindtap="goToLogin"
      />
      <button
        class="btn btn-primary comment-btn {{submitting ? 'disabled' : ''}}"
        bindtap="submitComment"
        disabled="{{!isLoggedIn || submitting}}"
      >
        {{submitting ? '发送中...' : '发送'}}
      </button>
    </view>

    <!-- 未登录提示：登录链接 -->
    <view wx:if="{{!isLoggedIn}}" class="login-hint" bindtap="goToLogin">
      <text class="login-link-text">登录或注册</text>
      <text class="hint-text">后即可发表评论</text>
    </view>

    <!-- 评论列表 -->
    <view class="comment-list">
      <view wx:for="{{comments}}" wx:key="id" class="comment-item">
        <image wx:if="{{item.user.avatar}}" src="{{item.user.avatar}}" class="comment-avatar"></image>
        <view class="comment-info">
          <view class="comment-user">{{item.user.nickname}}</view>
          <view class="comment-content">{{item.content}}</view>
          <view class="comment-time text-secondary">{{item.createdAt}}</view>
        </view>
      </view>

      <!-- 没有评论 -->
      <view class="empty" wx:if="{{comments.length === 0}}">
        <text>暂无评论，来抢沙发吧~</text>
      </view>

      <!-- 加载更多 -->
      <view class="loading" wx:if="{{hasMoreComment}}">
        <text class="text-secondary" bindtap="loadComments">加载更多评论</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading full" wx:if="{{loading}}">
  <text class="text-secondary">加载中...</text>
</view>
