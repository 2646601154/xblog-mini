/* 用户页样式 */

.user-header {
  text-align: center;
  padding: 48rpx 24rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 48rpx;
}

.avatar-placeholder.large {
  width: 160rpx;
  height: 160rpx;
  font-size: 64rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.username {
  font-size: 26rpx;
}

.not-login {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-tips {
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.login-btns {
  display: flex;
  gap: 24rpx;
}

.login-btns .btn {
  min-width: 200rpx;
}

/* 菜单列表 */
.menu-list {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  flex: 1;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-btn {
  margin-top: 48rpx;
  padding: 0 24rpx;
}

.logout-btn .btn.full {
  width: 100%;
}

/* 版本信息 */
.version-info {
  margin-top: 80rpx;
  font-size: 24rpx;
}
