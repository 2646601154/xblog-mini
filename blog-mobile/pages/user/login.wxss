/* 登录页样式 */

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.logo {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
}

.form {
  padding: 40rpx 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.btn.full {
  width: 100%;
}

.btn.disabled {
  opacity: 0.6;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
}

.btn-wechat {
  background: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.wechat-icon {
  font-size: 36rpx;
}

.footer {
  margin-top: 48rpx;
  font-size: 28rpx;
}

.footer text {
  margin: 0 8rpx;
}
