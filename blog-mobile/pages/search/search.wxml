<view class="container">
  <!-- 标签云 -->
  <view class="tag-section card">
    <view class="section-title">标签</view>
    <view class="tag-cloud">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-item {{selectedTag === item.id ? 'active' : ''}}"
        bindtap="selectTag"
        data-id="{{item.id}}"
      >
        {{item.name}}
        <text class="tag-count">({{item.articleCount || 0}})</text>
      </view>
    </view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list" wx:if="{{selectedTag}}">
    <view class="section-title">文章</view>
    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="article-item card"
      bindtap="goToArticle"
      data-id="{{item.id}}"
    >
      <view class="article-title text-ellipsis-2">{{item.title}}</view>
      <view class="article-summary text-ellipsis text-secondary">{{item.summary}}</view>
      <view class="article-meta flex-between mt-10">
        <text class="text-secondary">{{item.author.nickname}}</text>
        <text class="text-secondary">{{item.viewCount}} 阅读</text>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text class="text-secondary">加载中...</text>
    </view>

    <view class="empty" wx:if="{{!loading && articles.length === 0}}">
      <text>该标签暂无文章</text>
    </view>

    <view class="loading" wx:if="{{!hasMore && articles.length > 0}}">
      <text class="text-secondary">没有更多了</text>
    </view>
  </view>

  <!-- 无标签选中 -->
  <view class="empty" wx:if="{{!selectedTag && !loading}}">
    <text>请选择一个标签</text>
  </view>
</view>
