<view class="container">
  <!-- 搜索框 -->
  <view class="search-box">
    <input
      class="search-input"
      placeholder="搜索文章..."
      value="{{searchKeyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
    />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!articles.length && searchHistory.length > 0}}">
    <view class="section-header flex-between">
      <text class="section-title">搜索历史</text>
      <text class="clear-btn" bindtap="clearHistory">清除</text>
    </view>
    <view class="history-tags">
      <view
        wx:for="{{searchHistory}}"
        wx:key="index"
        class="history-tag"
        bindtap="useHistory"
        data-keyword="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="result-section" wx:if="{{articles.length > 0}}">
    <view class="result-tip text-secondary mb-20">找到 {{articles.length}} 篇文章</view>
    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="article-item card"
      bindtap="goToArticle"
      data-id="{{item.id}}"
    >
      <view class="article-title text-ellipsis-2">{{item.title}}</view>
      <view class="article-summary text-ellipsis text-secondary">{{item.summary}}</view>
      <view class="article-meta flex-between mt-10">
        <text class="text-secondary">{{item.author.nickname}}</text>
        <text class="text-secondary">{{item.viewCount}} 阅读</text>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text class="text-secondary">加载中...</text>
    </view>

    <view class="loading" wx:if="{{!hasMore && articles.length > 0}}">
      <text class="text-secondary">没有更多了</text>
    </view>
  </view>

  <!-- 无结果 -->
  <view class="empty" wx:if="{{noResult}}">
    <text class="empty-icon">🔍</text>
    <text>未找到相关文章</text>
  </view>
</view>
