/* 分类页样式 */

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.category-section {
  margin-bottom: 24rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: 1rpx solid #eee;
}

.category-item.active {
  background: var(--primary-color);
  color: #fff;
  border-color: var(--primary-color);
}

.category-name {
  font-weight: 500;
}

.category-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.tag-section {
  margin-bottom: 24rpx;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: rgba(24, 144, 255, 0.1);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 26rpx;
}

.article-item {
  margin-bottom: 16rpx;
}

.article-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
}
