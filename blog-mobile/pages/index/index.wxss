/* 首页样式 */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
}

.search-placeholder {
  margin-left: 16rpx;
  color: #999;
  font-size: 28rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  overflow-x: auto;
  margin-bottom: 24rpx;
}

.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #f0f0f0;
  color: #666;
}

.filter-item.active {
  background: var(--primary-color);
  color: #fff;
}

/* 文章卡片 */
.article-card {
  display: flex;
  flex-direction: column;
}

.article-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.article-content {
  flex: 1;
}

.article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.article-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.article-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.avatar-small {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.meta-text {
  margin: 0 8rpx;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: var(--primary-color);
  background: rgba(24, 144, 255, 0.1);
  border-radius: 4rpx;
}
