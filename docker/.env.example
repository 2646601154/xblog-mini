# ============================================================
# Xblog-mini 环境变量配置模板
# 使用方法：cp .env.example .env，然后修改对应的值
# ============================================================

# 域名配置
DOMAIN=xiaruoxin.cn

# MySQL Configuration
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=xblog

# Redis Configuration
REDIS_HOST=blog-redis
REDIS_PORT=6379
REDIS_PASSWORD=请设置一个强密码
REDIS_DB=1

# Backend API Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://blog-mysql:3306/xblog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_PASSWORD=123456

# JWT Configuration
JWT_SECRET=请生成一个随机强密钥（推荐: openssl rand -base64 64）
JWT_EXPIRATION=604800000
JWT_ACCESS_EXPIRATION=900000

# JVM Configuration
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# 阿里云 OSS 配置
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET_NAME=xblog-mini
OSS_URL_PREFIX=https://xblog-mini.oss-cn-beijing.aliyuncs.com

# Certbot Configuration
# 0 = 正式证书，1 = 测试证书（首次部署建议先用1测试）
LETSENCRYPT_STAGING=0

# Frontend API Base URL (for build-time embedding)
VITE_API_BASE_URL=/api
